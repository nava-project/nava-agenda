# Proxy inverso, HTTPS automático y archivos estáticos de NAVA.
# Variables (las inyecta compose desde stack.env):
#   DOMAIN      dominio público, p. ej. nava.wtf (con `localhost` Caddy usa su CA interna)
#   ACME_EMAIL  correo de aviso para Let's Encrypt
#
# Este Caddy es el único dueño de 80/443 en la VPS. También sirve otros proyectos del
# mismo dueño que corren en sus propias pilas y llegan por la red Docker externa `edge`
# (DEC-176): cada uno con su subdominio y su alias en esa red.
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# La detección de ubicación del domicilio usa la geolocalización del navegador.
		Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
		-Server
	}

	# API: el contrato OpenAPI declara `servers: /api/v1` en el mismo origen, así
	# que la cookie de sesión HttpOnly viaja sin CORS ni SameSite entre orígenes.
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8080 {
			# Caddy ya envía X-Forwarded-For con la IP real del cliente; el API la
			# acepta solo desde este proxy (APP_TRUSTED_PROXIES).
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Sondeo de disponibilidad para monitores externos (no expone la base de datos).
	handle /health {
		reverse_proxy api:8080
	}
	# /health/db revela el estado de la base de datos: solo es accesible dentro de la red de Docker.
	handle /health/* {
		respond 404
	}

	# SPA: archivos con hash inmutables; el resto cae en index.html (history mode).
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Nava · Pedidos (repo aparte, pila `pedidos` en /srv/pedidos; DEC-176). Llega por la red
# `edge` con el alias `pedidos`. Si esa pila está caída, solo este sitio responde 502: el
# upstream se resuelve en cada petición y no impide que Caddy arranque.
pedidos.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Los comprobantes de pago llegan como imagen de hasta 5 MB.
	request_body {
		max_size 6MB
	}

	reverse_proxy pedidos:8080 {
		# La bandeja se actualiza en vivo por Server-Sent Events (/api/stream): sin búfer.
		flush_interval -1
		transport http {
			dial_timeout 5s
		}
	}
}
