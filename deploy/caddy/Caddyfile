# Proxy inverso, HTTPS automático y archivos estáticos de Nava Agenda.
# Variables (las inyecta compose desde stack.env):
#   DOMAIN      dominio raíz de la familia NAVA, p. ej. nava.wtf (con `localhost` Caddy usa su
#               CA interna). La app vive en agenda.{$DOMAIN} (DEC-183).
#   ACME_EMAIL  correo de aviso para Let's Encrypt
#
# Este Caddy es el único dueño de 80/443 en la VPS. También sirve otros proyectos del
# mismo dueño que corren en sus propias pilas y llegan por la red Docker externa `edge`
# (DEC-176): cada uno con su subdominio y su alias en esa red.
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# API de Nava Agenda y su sondeo de salud, en agenda.{$DOMAIN} (DEC-183).
(nava_agenda_api) {
	# API: el contrato OpenAPI declara `servers: /api/v1` en el mismo origen, así
	# que la cookie de sesión HttpOnly viaja sin CORS ni SameSite entre orígenes.
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8080 {
			# Caddy ya envía X-Forwarded-For con la IP real del cliente; el API la
			# acepta solo desde este proxy (APP_TRUSTED_PROXIES).
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Sondeo de disponibilidad para monitores externos (no expone la base de datos).
	handle /health {
		reverse_proxy api:8080
	}
	# /health/db revela el estado de la base de datos: solo es accesible dentro de la red de Docker.
	handle /health/* {
		respond 404
	}
}

# La app (SPA + API) de Nava Agenda (DEC-183), servida en agenda.{$DOMAIN}.
(nava_agenda) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# La detección de ubicación del domicilio usa la geolocalización del navegador.
		Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
		-Server
	}

	import nava_agenda_api

	# SPA: archivos con hash inmutables; el resto cae en index.html (history mode).
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

agenda.{$DOMAIN} {
	# Los documentos legales viven en la landing (#658); sus URL están registradas en Google.
	redir /privacidad https://{$DOMAIN}/privacidad 308
	redir /terminos https://{$DOMAIN}/terminos 308
	import nava_agenda
}

# Landing de la familia NAVA (repo bcaceres19/nava, pila `nava-landing` en /srv/nava; DEC-183,
# #658). Llega por la red `edge` con el alias `nava-landing`. Las rutas de la app que aún
# lleguen aquí (enlaces viejos de correos y WhatsApp) van a agenda.{$DOMAIN} con la misma
# ruta. El API ya no responde aquí: Odin usa agenda.{$DOMAIN} desde #685.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@agenda path /acceso /acceso/* /recuperar-acceso /recuperar-acceso/* /panel /panel/* /reservar/* /mi-turno/*
	redir @agenda https://agenda.{$DOMAIN}{uri} 308

	handle {
		reverse_proxy nava-landing:8080 {
			transport http {
				dial_timeout 5s
			}
		}
	}
}

# Nava · Pedidos (repo aparte, pila `pedidos` en /srv/pedidos; DEC-176). Llega por la red
# `edge` con el alias `pedidos`. Si esa pila está caída, solo este sitio responde 502: el
# upstream se resuelve en cada petición y no impide que Caddy arranque.
pedidos.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Los comprobantes de pago llegan como imagen de hasta 5 MB.
	request_body {
		max_size 6MB
	}

	reverse_proxy pedidos:8080 {
		# La bandeja se actualiza en vivo por Server-Sent Events (/api/stream): sin búfer.
		flush_interval -1
		transport http {
			dial_timeout 5s
		}
	}
}

# Nava Nexos (repo bcaceres19/nava-nexos, ADR 027; #679): solo su webhook de WhatsApp. Llega
# por la red `nexos-edge` (aparte de `edge`) con el alias `nexos`. Ninguna otra ruta pasa:
# ni /health, ni /webhooks/pedidos, ni el simulador. La firma HMAC de Meta la valida Nexos.
nexos.{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@webhook {
		path /webhooks/whatsapp
		method GET POST
	}
	handle @webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy nexos:7870 {
			transport http {
				dial_timeout 5s
				response_header_timeout 15s
			}
		}
	}

	handle {
		respond 404
	}
}

# Jenkins de la VPS (CI/CD de todos los proyectos; pila `jenkins` en /srv/jenkins; DEC-177).
# Llega por la red `edge` con el alias `jenkins`. Jenkins exige usuario y contraseña; el
# webhook de GitHub (/github-webhook/) se valida con su firma HMAC. Si Jenkins está
# caído, solo este sitio responde 502.
jenkins.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy jenkins:8080 {
		transport http {
			dial_timeout 5s
		}
	}
}
